<?xml version="1.0"?>

<?xml-stylesheet type="text/xsl" href="entry_id.xsl" ?>

<entry_id version="3.0">
  <!-- modifier_mode allowed values are
       '*' 0 or more modifiers (default)
       '1' exactly 1 modifier
       '?' 0 or 1 modifiers
       '+' 1 or more modifiers

       This file may have emis desc entries.
  -->
  <description modifier_mode="1">
    <desc emis="Demis[%ECPL]">Data emission model (Demis) </desc>
    <desc option="ECPL">emission coupling mode for air composition</desc>
  </description>

  <entry id="COMP_emis">
    <type>char</type>
    <valid_values>demis</valid_values>
    <default_value>demis</default_value>
    <group>case_comp</group>
    <file>env_case.xml</file>
    <desc>Name of emission component</desc>
  </entry>

  <entry id="Demis_MODE">
    <type>char</type>
    <valid_values>ECPL</valid_values>
    <default_value>ECPL</default_value>
    <values match="last">
      <value compset="Demis%ECPL">ECPL</value>
    </values>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc>
      model mode.
      In ECPL, emission forcing data for air composition modeling
      is handled through the coupler interface.
    </desc>
  </entry>

  <entry id="Demis_CPLHIST_DIR">
    <type>char</type>
    <default_value>UNSET</default_value>
    <values match="last">
      <value compset="1850.*_Demis%ECPL" grid="l%0.9x1.25">$DIN_LOC_ROOT/emis/demis7/CPLHIST_EMIS/b.e21.B1850.f09_g17.CMIP6-piControl.001_c210324</value>
    </values>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc>directory for coupler history data mode (only used for CPLHIST mode)</desc>
  </entry>

  <entry id="Demis_CPLHIST_CASE">
    <type>char</type>
    <default_value>UNSET</default_value>
    <values match="last">
      <value compset="1850.*_Demis%ECPL" grid="l%0.9x1.25">b.e21.B1850.f09_g17.CMIP6-piControl.001</value>
    </values>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc>case name for coupler history data mode (only used for CPLHIST mode)</desc>
  </entry>

  <entry id="Demis_CPLHIST_YR_ALIGN">
    <type>integer</type>
    <default_value>-999</default_value>
    <values match="last">
      <value compset="1850.*_Demis%ECPL" grid="l%0.9x1.25">1</value>
    </values>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc>
      Simulation year corresponding to Demis_CPLHIST_YR_START (only used
      when Demis_MODE is CPLHIST). A common usage is to
      set this to RUN_STARTDATE. With this setting, the forcing in the
      first year of the run will be the forcing of year
      Demis_CPLHIST_YR_START. Another use case is to align the calendar
      of transient forcing with the model calendar. For example, setting
      Demis_CPLHIST_YR_ALIGN=Demis_CPLHIST_YR_START will lead to the
      forcing calendar being the same as the model calendar. The forcing
      for a given model year would be the forcing of the same year. This
      would be appropriate in transient runs where the model calendar is
      setup to span the same year range as the forcing data.
    </desc>
  </entry>

  <entry id="Demis_CPLHIST_YR_START">
    <type>integer</type>
    <default_value>-999</default_value>
    <values match="last">
      <value compset="1850.*_Demis%SCPL" grid="l%0.9x1.25">1971</value>
    </values>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc>starting year to loop data over (only used when Demis_MODE is CPLHIST)</desc>
  </entry>

  <entry id="Demis_CPLHIST_YR_END">
    <type>integer</type>
    <default_value>-999</default_value>
    <values match="last">
      <value compset="1850.*_Demis%SCPL" grid="l%0.9x1.25">2000</value>
    </values>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc>ending year to loop data over (only used when Demis_MODE is CPLHIST)</desc>
  </entry>

  <entry id="Demis_SKIP_RESTART_READ">
    <type>logical</type>
    <valid_values>TRUE,FALSE</valid_values>
    <default_value>FALSE</default_value>
    <group>run_component_demis</group>
    <file>env_run.xml</file>
    <desc> If set to true, than demis restarts will not be read on a continuation run.
    </desc>
  </entry>

  <help>
    =========================================
    Demis naming conventions
    =========================================
  </help>

</entry_id>
